<h1 class="text-center">Transactions</h1>
<table class="table table-striped table-hover">
  <tr class="table-dark">
    <th>Order Id</th><th>Transaction Type</th><th>Date</th>
  </tr>
  <% @transactions.each do |t| %>
    <tr>
      <td><%= t.order_id %></td>
      <td><%= t.transaction_type %></td>
      <td><%= t.created_at.to_date %></td>
    </tr>
  <% end %>
</table>
